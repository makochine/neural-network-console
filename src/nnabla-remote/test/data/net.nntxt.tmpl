    input: "Tanh_2"
    input: "Affine/affine/W"
    input: "Affine/affine/b"
    output: "Affine"
    affine_param {
      base_axis: 1
    }
  }
  function {
    name: "Tanh_3"
    type: "Tanh"
    input: "Affine"
    output: "Tanh_3"
  }
  function {
    name: "Affine_2"
