      type: "Constant"
      multiplier: 1
    }
  }
  variable {
    name: "BatchNormalization_2/bn/mean"
    type: "Parameter"
    shape: { dim: 1 dim: 128 dim: 1 dim: 1 }
    initializer {
      type: "Constant"
      multiplier: 0
    }
  }
  variable {
    name: "BatchNormalization_2/bn/var"
    type: "Parameter"
    shape: { dim: 1 dim: 128 dim: 1 dim: 1 }
    initializer {
      type: "Constant"
