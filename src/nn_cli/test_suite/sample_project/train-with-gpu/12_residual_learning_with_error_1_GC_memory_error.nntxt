dataset {
  name: "Training"
  uri: "../../sample_dataset/MNIST/small_mnist_4or9_training.csv"
  cache_dir: "train-with-cpu/output/small_mnist_4or9_training-hugebatch.cache"
  overwrite_cache: false
  create_cache_explicitly: true
  shuffle: true
  no_image_normalization: false
  batch_size: 1024
}
dataset {
  name: "Validation"
  uri: "../../sample_dataset/MNIST/small_mnist_4or9_test.csv"
  cache_dir: "train-with-cpu/output/small_mnist_4or9_test-hugebatch.cache"
